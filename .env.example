# ─────────────────────────────────────────────────────────────
# Tollywood Analysis — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# Only variables prefixed NEXT_PUBLIC_ are visible in the browser.
# ─────────────────────────────────────────────────────────────

# "real" (default): bundled Wikipedia + Wikidata snapshot (npm run data:import). No database needed.
# "demo": synthetic, clearly-labelled demo data computed in memory.
# "live": reads the database; the dashboard shows the latest persisted calculation.
NEXT_PUBLIC_DATA_MODE=real

# Fans' ranking (visitors rank their top 3 heroes). Off by default.
# Set to "true" and redeploy to show it. Votes persist only when DATABASE_URL is set
# (without a database they are kept in server memory and reset on restart).
NEXT_PUBLIC_FEATURE_USER_RANKING=false

# Postgres connection string (Supabase → Project Settings → Database → Connection string → URI).
# Use the pooled "Transaction" connection (port 6543) on Vercel. Required for live mode and admin writes.
DATABASE_URL=

# Long random string (32+ chars) used to sign in at /admin and as a Bearer token for admin APIs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ── Provider kill switches (all off by default) ────────────────
# TMDb: primary metadata/credits source. Use the "API Read Access Token" (v4 bearer).
FEATURE_TMDB=false
TMDB_API_READ_TOKEN=

# IMDb: stays disabled unless you hold a licence / permitted API. Nothing is ever scraped.
FEATURE_IMDB_LICENSED=false
IMDB_LICENSED_ENDPOINT=
IMDB_LICENSED_API_KEY=

# Instagram Graph API (Business Discovery) — official professional accounts only.
FEATURE_INSTAGRAM=false
META_GRAPH_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=

# X API v2 (approved access tier required).
FEATURE_X=false
X_BEARER_TOKEN=

# YouTube Data API v3.
FEATURE_YOUTUBE=false
YOUTUBE_API_KEY=

# Facebook pages via Meta Graph API (uses META_GRAPH_ACCESS_TOKEN), only where permitted.
FEATURE_FACEBOOK=false

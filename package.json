{
  "name": "tollywood-analysis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed:demo": "tsx scripts/db-seed.ts --demo",
    "db:recalculate": "tsx scripts/db-recalculate.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "photos:fetch": "tsx scripts/fetch-hero-photos.ts",
    "data:import": "tsx scripts/import-real-data.mts",
    "tolly:imdb": "tsx scripts/tolly/imdb-ratings.mts",
    "tolly:pageviews": "tsx scripts/tolly/fetch-pageviews.mts",
    "tolly:compute": "tsx scripts/tolly/compute.mts",
    "tolly:wikidata": "tsx scripts/tolly/wikidata.mts",
    "tolly:cast": "tsx scripts/tolly/imdb-cast.mts",
    "tolly:link": "tsx scripts/tolly/link-films.mts",
    "tolly:extra": "tsx scripts/tolly/imdb-extra.mts",
    "tolly:all": "npm run tolly:wikidata && npm run tolly:imdb && npm run tolly:cast && npm run tolly:link && npm run tolly:extra && npm run tolly:link && npm run tolly:pageviews && npm run tolly:tmdb && npm run tolly:compute",
    "tolly:tmdb": "tsx --env-file-if-exists=.env.local scripts/tolly/tmdb.mts",
    "tolly:tmdb-search": "tsx --env-file-if-exists=.env.local scripts/tolly/tmdb-search.mts",
    "tolly:omdb": "tsx --env-file-if-exists=.env.local scripts/tolly/omdb.mts",
    "tolly:bluesky": "tsx scripts/tolly/bluesky.mts",
    "tolly:bluesky-voice": "python3 scripts/tolly/bluesky_sentiment.py",
    "tolly:youtube": "tsx --env-file-if-exists=.env.local scripts/tolly/youtube.mts",
    "tolly:reddit": "tsx --env-file-if-exists=.env.local scripts/tolly/reddit.mts",
    "tolly:snapshot": "bash scripts/tolly/snapshot.sh snapshot",
    "tolly:restore": "bash scripts/tolly/snapshot.sh restore"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^8.21.3",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
